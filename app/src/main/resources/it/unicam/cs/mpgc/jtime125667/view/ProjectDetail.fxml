<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="it.unicam.cs.mpgc.jtime125667.controller.ProjectDetailController"
            style="-fx-background-color: white;">
    
    <top>
        <VBox spacing="15" style="-fx-background-color: #f9f9f9; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Button text="← Torna ai Progetti" onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-padding: 0; -fx-font-size: 13px; -fx-font-weight: bold;"/>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="projectNameLabel" text="Nome Progetto" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="projectDescriptionLabel" text="Descrizione del progetto..." wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
                </VBox>
                
                <VBox alignment="CENTER_RIGHT" spacing="5">
                   <Label text="STATO PROGETTO" style="-fx-font-size: 9px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
                   <CheckBox fx:id="completedCheckBox" text="Segna come Completato" onAction="#handleToggleComplete" style="-fx-font-size: 13px; -fx-cursor: hand;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Attività (Tasks)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ecf0f1;">
                <columns>
                    <TableColumn fx:id="statusColumn" text="Stato" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="titleColumn" text="Titolo Attività" prefWidth="300"/>
                    <TableColumn fx:id="dateColumn" text="Data" prefWidth="100" style="-fx-alignment: CENTER_LEFT; -fx-text-fill: #555;"/>
                    <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="150" style="-fx-text-fill: #7f8c8d;"/>
                    <TableColumn fx:id="estimatedTimeColumn" text="Stima" prefWidth="90" style="-fx-alignment: CENTER_RIGHT;"/>
                    <TableColumn fx:id="actualTimeColumn" text="Effettivo" prefWidth="90" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
    
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-background-color: #f9f9f9; -fx-border-color: #eee; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            
            <Button text="Genera Report" onAction="#handleReport" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-text-fill: #34495e; -fx-cursor: hand;"/>
            
            <Region HBox.hgrow="SOMETIMES" />
            
            <Button text="Elimina" onAction="#handleDeleteTask" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button text="Modifica" onAction="#handleEditTask" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
            
            <Button text="Completa Task" onAction="#handleCompleteTask" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>

            <Button text="+ Aggiungi Task" onAction="#handleAddTask" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
    
</BorderPane>