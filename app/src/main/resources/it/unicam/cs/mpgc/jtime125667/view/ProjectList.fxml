<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="it.unicam.cs.mpgc.jtime125667.controller.ProjectListController">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="I Miei Progetti" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="filterActiveCheckBox" text="Nascondi completati" style="-fx-font-size: 14px;"/>
        </HBox>
    </top>
    
    <center>
        <ListView fx:id="projectListView" />
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Button text="📅 Apri Agenda" onAction="#handleOpenAgenda" style="-fx-base: #b6e7c9;"/>
            <Button text="➕ Nuovo Progetto" onAction="#handleNewProject"/>
            <Button text="📂 Apri Selezionato" onAction="#handleOpenProject"/>
            <Button text="🗑️ Elimina" onAction="#handleDeleteProject" style="-fx-text-fill: red;"/>
        </HBox>
    </bottom>
    
</BorderPane>