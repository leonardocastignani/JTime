<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="it.unicam.cs.mpgc.jtime125667.controller.ProjectListController"
            style="-fx-background-color: white;">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #ffffff; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
            <Label text="I Miei Progetti" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="filterActiveCheckBox" text="Nascondi completati" focusTraversable="false" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-cursor: hand;"/>
        </HBox>
    </top>
    
    <center>
        <ListView fx:id="projectListView" focusTraversable="false" style="-fx-background-insets: 0; -fx-padding: 20; -fx-background-color: #fcfcfc; -fx-border-color: transparent;" />
    </center>
    
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-background-color: #ffffff; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
            
            <Button text="Agenda Giornaliera" onAction="#handleOpenAgenda" focusTraversable="false" style="-fx-background-color: #dfe6e9; -fx-text-fill: #2d3436; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold; -fx-pref-height: 32px;"/>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button text="Elimina" onAction="#handleDeleteProject" focusTraversable="false" style="-fx-background-color: #fab1a0; -fx-text-fill: #c0392b; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold; -fx-pref-height: 32px;"/>
            
            <Button text="Apri Dettaglio" onAction="#handleOpenProject" focusTraversable="false" style="-fx-background-color: #74b9ff; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold; -fx-pref-height: 32px;"/>
            
            <Button text="+ Nuovo Progetto" onAction="#handleNewProject" focusTraversable="false" style="-fx-background-color: #00b894; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4; -fx-font-weight: bold; -fx-pref-height: 32px; -fx-padding: 0 20;"/>
        </HBox>
    </bottom>
    
</BorderPane>