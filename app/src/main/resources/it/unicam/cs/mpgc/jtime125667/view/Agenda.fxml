<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="it.unicam.cs.mpgc.jtime125667.controller.AgendaController"
            style="-fx-background-color: white;">
    
    <top>
        <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

            <Button text="← Torna alla Home" onAction="#handleBack" focusTraversable="false" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand; -fx-padding: 0; -fx-font-size: 13px; -fx-font-weight: bold;"/>

            <HBox spacing="30" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                   <Label text="Agenda Giornaliera" style="-fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </HBox>
                
                <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 5 15; -fx-background-radius: 8;">
                   <Label text="Data:" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
                   <DatePicker fx:id="agendaDatePicker" onAction="#handleDateChange" focusTraversable="false" style="-fx-font-size: 14px;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #fcfcfc;">
            <TableView fx:id="agendaTable" focusTraversable="false" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #ecf0f1; -fx-border-radius: 4;">
                <columns>
                    <TableColumn fx:id="statusColumn" text="Stato" prefWidth="110" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="projectColumn" text="Progetto" prefWidth="200" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TableColumn fx:id="taskColumn" text="Attività" prefWidth="300"/>
                    <TableColumn fx:id="timeColumn" text="Stima Tempo" prefWidth="120" style="-fx-alignment: CENTER_RIGHT;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Nessun task pianificato per questa data." style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #ffffff; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
            <padding><Insets top="15" right="25" bottom="15" left="25"/></padding>
            
            <Button text="Report Giornaliero" onAction="#handleDailyReport" focusTraversable="false" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-text-fill: #34495e; -fx-cursor: hand; -fx-pref-height: 32px;"/>
            
            <Region HBox.hgrow="ALWAYS" />

            <Label text="Totale Impegno:" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="totalEffortLabel" text="0h 0m" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;"/>
        </HBox>
    </bottom>
    
</BorderPane>